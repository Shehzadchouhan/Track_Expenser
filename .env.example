# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
# Public WhatsApp business number in international digits-only format, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
